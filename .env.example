# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - ELECTROGUIA-RAG-TAVILY
# Instrucciones: Copia este archivo, renómbralo a ".env" y completa tus valores.
# ==============================================================================

# --- ORACLE CLOUD INFRASTRUCTURE (OCI) & COHERE ---
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..tu_compartment_id_aqui
OCI_CONFIG_PROFILE=DEFAULT

# Almacenamiento en la nube (Opcional si trabajas inicialmente con PDFs locales)
OCI_BUCKET_NAME=electroguia-documents
OCI_NAMESPACE=tu_namespace_oci_aqui

# Endpoints y Modelos de OCI Generative AI
OCI_GENAI_ENDPOINT=https://oraclecloud.com
OCI_LLM_MODEL_ID=cohere.command-a-03-2025
OCI_EMBEDDING_MODEL_ID=cohere.embed-v4.0

# --- BÚSQUEDA WEB EN TIEMPO REAL (TAVILY SEARCH API) ---
# Obtén tu API Key gratuita en: https://tavily.com
TAVILY_API_KEY=tvly-tu_api_key_de_tavily_aqui
TAVILY_MAX_RESULTS=3

# --- PARÁMETROS GENERALES DEL PIPELINE RAG ---
DATA_DIR=data/
VECTOR_DB_DIR=faiss_index/
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
